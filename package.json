{
  "name": "mcu-ios-gitflow",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "description": "Самостоятельный плагин Codex для MCU iOS Git Flow",
  "main": "./dsh/lib/index.js",
  "exports": {
    ".": "./dsh/lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/check.mjs",
    "validate": "node scripts/validate-package.mjs",
    "test": "node --test test/*.test.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "dsh:mcp": "node dsh/install-mcp.mjs"
  }
}
